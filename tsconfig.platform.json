{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "apps/platform",
    "apps/portal",
    "packages/session-kit",
    "packages/telegram-transport",
    "vite.platform.config.ts",
    "vitest.platform.config.ts",
    "games/district",
    "games/test-bench"
  ]
}
