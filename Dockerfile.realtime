FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*
COPY . .
COPY --from=realtime-retained / /retention-input/
RUN npm ci
ARG VCS_REF=unknown
ENV IVA_BUILD_SHA=$VCS_REF
RUN npm run build --workspace @iva-games/forpost && npm run build --workspace @iva-games/realtime-server \
    && node dist-realtime/retention-cli.js seal --input /retention-input --output /app/retention \
       --runtime /app/dist-realtime --client /app/games/forpost/dist --revision "$VCS_REF" \
    && npm prune --omit=dev --ignore-scripts

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/decorum-guy/iva-games" org.opencontainers.image.revision=$VCS_REF
ENV NODE_ENV=production REALTIME_HOST=0.0.0.0 REALTIME_PORT=4331 REALTIME_PUBLIC_ORIGIN=https://iva-games.pro REALTIME_DATABASE_PATH=/data/realtime.sqlite REALTIME_PRACTICE_KEY_PATH=/data/practice-key.pem REALTIME_STATIC_DIRECTORY=/app/client REALTIME_RETENTION_DIRECTORY=/app/retention IVA_BUILD_SHA=$VCS_REF
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist-realtime ./dist-realtime
COPY --from=build /app/games/forpost/dist ./client
COPY --from=build --chown=node:node /app/retention ./retention
COPY packages/game-registry/games.json ./game-registry.json
COPY deploy/iva-games/realtime-control.mjs ./scripts/realtime-control.mjs
RUN mkdir -p /data && chown node:node /data
USER node
EXPOSE 4331
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:4331/health/ready',{signal:AbortSignal.timeout(3000)}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "dist-realtime/main.js"]
