{
  "name": "iva-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "games/chess/*",
    "games/*",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @chess-2/remorse --",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:remorse": "npm run build --workspace @chess-2/remorse --",
    "build:overdrive": "npm run build --workspace @chess-2/overdrive --",
    "build:client": "node --experimental-strip-types scripts/check-game-registry.mjs && node --experimental-strip-types scripts/build-chess.mjs && npm run build:chess-home && node --experimental-strip-types scripts/compose-client.mjs",
    "build:chess-home": "vite build --config apps/portal/chess-home/vite.config.ts",
    "chess-home:e2e": "playwright test --config apps/portal/chess-home/playwright.config.ts",
    "build:server": "npm run build --workspace @chess-2/server --",
    "preview": "vite preview --outDir dist",
    "auditions:build": "npm run typecheck && npm run auditions:build --workspace @chess-2/remorse --",
    "auditions:preview": "npm run auditions:preview --workspace @chess-2/remorse --",
    "auditions:test": "playwright test --config games/chess/remorse/playwright.auditions.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundaries": "npm run check:registry && node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm run typecheck && npm run typecheck:realtime && npm run lint && npm test",
    "test:e2e": "playwright test --config games/chess/remorse/playwright.config.ts",
    "start": "node dist-server/main.js",
    "dev:server": "npm run build:server && node --watch dist-server/main.js",
    "test:online": "vitest run --project server --project remorse online",
    "remorse:test": "npm run test --workspace @chess-2/remorse --",
    "overdrive:dev": "npm run dev --workspace @chess-2/overdrive --",
    "overdrive:test": "npm run test --workspace @chess-2/overdrive --",
    "overdrive:e2e": "playwright test --config games/chess/overdrive/playwright.config.ts",
    "overdrive:smoke": "node scripts/overdrive-smoke.mjs",
    "overdrive:balance": "npm run balance --workspace @chess-2/overdrive --",
    "overdrive:balance:audit": "node games/chess/overdrive/scripts/overdrive-balance-audit.mjs",
    "overdrive:balance:probes": "node games/chess/overdrive/scripts/overdrive-balance-probes.mjs",
    "overdrive:models": "npm run models --workspace @chess-2/overdrive --",
    "overdrive:audio": "npm run audio --workspace @chess-2/overdrive --",
    "sdk:test": "npm run test --workspace @chess-2/engine-sdk --",
    "server:test": "npm run test --workspace @chess-2/server --",
    "workspace:smoke": "node scripts/workspace-smoke.mjs",
    "dev:portal": "npm --prefix apps/portal run dev",
    "dev:platform": "npm run build:platform && node --env-file-if-exists=.env dist-platform/main.js",
    "build:portal": "npm --prefix apps/portal run build",
    "build:platform": "vite build --config vite.platform.config.ts",
    "build:foundation": "npm run typecheck:platform && npm run build:platform && npm run build:portal && npm run build:realtime-clients",
    "build:realtime-clients": "node --experimental-strip-types scripts/build-realtime-clients.mjs",
    "build:realtime": "npm run typecheck:realtime && npm run build --workspace @iva-games/realtime-server",
    "tyaga:dev": "node scripts/dev-tyaga.mjs",
    "tyaga:build": "npm run build --workspace @iva-games/tyaga",
    "tyaga:test": "vitest run --project tyaga --project realtime",
    "typecheck:platform": "tsc --noEmit -p tsconfig.platform.json",
    "test:platform": "vitest run --config vitest.platform.config.ts",
    "check:platform": "npm run typecheck:platform && npm run lint:platform && npm run test:platform",
    "check:kz-bot": "node scripts/check-kz-bot.mjs",
    "platform:smoke": "node --experimental-strip-types scripts/platform-smoke.mjs",
    "start:platform": "node --env-file-if-exists=.env dist-platform/main.js",
    "lint:platform": "eslint apps/platform apps/portal/src games/district packages/session-kit packages/telegram-transport scripts/check-kz-bot.mjs vite.platform.config.ts vitest.platform.config.ts",
    "build:all": "npm run build && npm run build:foundation && npm run build:realtime",
    "portal:e2e": "playwright test --config apps/portal/playwright.config.ts",
    "district:test": "vitest run --project district",
    "district:maps": "node --experimental-strip-types games/district/scripts/check-maps.mjs",
    "district:simulate": "vite build --config games/district/vite.simulation.config.ts && node .qa/district-simulation-runner/simulate.mjs",
    "district:browser": "node scripts/district-browser-smoke.mjs",
    "colossus:dev": "npm run dev --workspace @chess-2/colossus --",
    "colossus:audio:build": "npm run audio:build --workspace @chess-2/colossus --",
    "colossus:audio:preview": "npm run audio:preview --workspace @chess-2/colossus --",
    "colossus:test": "npm run test --workspace @chess-2/colossus --",
    "colossus:balance": "node games/chess/colossus/scripts/colossus-balance.mjs",
    "colossus:e2e": "playwright test --config games/chess/colossus/playwright.config.ts",
    "build:colossus": "npm run build --workspace @chess-2/colossus --",
    "check:registry": "node --experimental-strip-types scripts/check-game-registry.mjs",
    "prebuild:foundation": "npm run check:registry",
    "typecheck:realtime": "npm run typecheck --workspace @iva-games/realtime-server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "ws": "8.23.0",
    "@types/nodemailer": "8.0.2"
  }
}
