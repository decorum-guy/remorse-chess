# Copy outside the checkout, e.g. /etc/iva-games/release.env.
# Use different immutable revisions when only one application changes.
CHESS_IMAGE=
PLATFORM_IMAGE=
REALTIME_IMAGE=
# Set after the one-time realtime host integration in REALTIME_HOST_INTEGRATION.md.
COMPOSE_PROFILES=
REALTIME_TRUSTED_KEYS_FILE=/etc/iva-games/realtime-trusted-keys.json
REALTIME_DATA_VOLUME=iva-games-realtime-data
REALTIME_MAX_ROOMS=4
# Resolve a reviewed caddy:2 tag to its actual repo digest before release.
CADDY_IMAGE=
PLATFORM_ENV_FILE=/etc/iva-games/platform.env
# Example private network: check for Docker/VPN subnet conflicts on the VPS.
# The same proxy IP is assigned to Caddy and trusted by both applications.
IVA_NETWORK_SUBNET=172.30.239.0/24
# Dynamic addresses stay in this part of the subnet, outside Caddy's static IP.
IVA_NETWORK_DYNAMIC_RANGE=172.30.239.128/25
CADDY_PROXY_IP=172.30.239.2
CHESS_DATA_VOLUME=iva-games-chess-data
PLATFORM_DATA_VOLUME=iva-games-platform-data
CADDY_DATA_VOLUME=iva-games-caddy-data
CADDY_CONFIG_VOLUME=iva-games-caddy-config
