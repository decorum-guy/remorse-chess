# Private runtime values only; never commit the populated file.
# Compose reads this as raw KEY=value: no shell quotes, expansion or escapes.
# Production uses Telegram for accounts. The catalogue can start without a bot.
MAIL_MODE=disabled
TELEGRAM_AUTH_ENABLED=false
TELEGRAM_AUTH_BOT_ID=
TELEGRAM_AUTH_BOT_USERNAME=
TELEGRAM_AUTH_WEBHOOK_SECRET=
TELEGRAM_AUTH_CODE_KEY_BASE64=

# Optional legacy email settings for standalone deployments.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional channel. Site invitations work with Telegram disabled.
# Enable only after the dedicated bot, HTTPS webhook and kz-bot route are ready.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROOF_KEY_BASE64=
TELEGRAM_PROXY_URL=
# Realtime is activated after the host migration and public-key provisioning.
# REALTIME_INTERNAL_ORIGIN=http://realtime:4331
# REALTIME_SIGNING_KEY_PATH=/data/realtime-platform-key.pem
# REALTIME_SIGNING_KEY_ID=platform-v1
