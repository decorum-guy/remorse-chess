{
  "name": "@iva-games/tyaga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/core/index.ts",
    "./server": "./src/server-world/adapter.ts",
    "./shared": "./src/core/index.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5284 --strictPort",
    "build": "npm run typecheck && vite build",
    "test": "vitest run --config vitest.config.ts",
    "models": "blender --background --python art/source/generate_models.py && blender --background --python art/source/generate_character.py",
    "audio": "python3 art/source/generate_audio.py",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@iva-games/realtime-kit": "0.1.0",
    "@iva-games/session-kit": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
