    } else if (m.type === 'end') result = await finishMeasurement();
    else if (m.type === 'status') result = { measuring, matches: cohort(), incompleteReasons: incompleteness };
    else if (m.type === 'stop') { await close(); result = { stopped: true }; }
    else throw new Error('Unknown measurement IPC operation');
    process.send?.({ id: m.id, ok: true, result });
    if (m.type === 'stop') process.disconnect?.();
  } catch (error) { process.send?.({ id: m.id, ok: false, error: error instanceof Error ? error.message : String(error) }); }
});
process.on('SIGTERM', () => { void close().then(() => process.exit(0), () => process.exit(1)); });
process.send?.({ type: 'ready', origin, normalAutoTick: true });
